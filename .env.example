# ResumeForge AI - Environment Configuration for Docker Home Server
# Copy this file to '.env' on your home server and add your Groq API Key.

# Your personal Groq API Key (starts with gsk_...)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Groq API Base URL
GROQ_BASE_URL=https://api.groq.com/openai/v1

# AI Temperature (0.0 to 0.8, default 0.2)
GROQ_TEMPERATURE=0.2
